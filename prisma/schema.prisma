generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id
  name            String
  email           String    @unique
  emailVerified   Boolean   @default(false)
  image           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  username        String?   @unique
  displayUsername String?
  role            String    @default("saleperson")
  accounts        Account[]
  cancelleedSales Sale[]    @relation("SaleCancelledBy")
  createdSales    Sale[]    @relation("SaleSaleperson")
  validatedSales  Sale[]    @relation("SaleValidatedBy")
  adjustedSales   Sale[]    @relation("SaleAdjustedBy")
  expenses        Expense[] @relation("ExpenseCreatedBy")
  cancelledExpenses Expense[] @relation("ExpenseCancelledBy")
  sessions        Session[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Product {
  id            String    @id @default(cuid())
  productName          String
  image         String
  purchasePrice Float
  sellingPrice  Float
  commission    Float
  quantity      Int       @default(0)
  stockAlert    Int       @default(5)
  description   String?
  producedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  sales         Sale[]

  @@index([deletedAt])
  @@map("products")
}

model Sale {
  id            String    @id @default(cuid())
  status        SaleState @default(pending)
  sellingPrice  Float
  commission    Float
  quantity      Int       @default(1)
  note          String?
  soldAt        DateTime  @default(now())
  validatedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  salepersonId  String
  validatorId   String?
  // Rôle du validateur au moment de la validation, figé même s'il change de poste ensuite
  validatorRole String?
  // Commission due à l'assistant(e) s'il/elle a validé la vente (0 sinon), figée à la validation
  assistantCommission Float @default(0)
  cancelledById String?
  // Ajustement du "dernier prix" par l'admin : prix et commission d'origine (prix fixé du produit)
  // conservés lors du premier ajustement, null si la vente n'a jamais été ajustée
  originalSellingPrice Float?
  originalCommission   Float?
  adjustedAt           DateTime?
  adjustedById         String?
  adjustedBy           User?   @relation("SaleAdjustedBy", fields: [adjustedById], references: [id])
  productId     String
  cancelledBy   User?     @relation("SaleCancelledBy", fields: [cancelledById], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  saleperson    User      @relation("SaleSaleperson", fields: [salepersonId], references: [id])
  validatedBy   User?     @relation("SaleValidatedBy", fields: [validatorId], references: [id])

  @@index([salepersonId])
  @@index([validatorId])
  @@index([cancelledById])
  @@index([adjustedById])
  @@index([productId])
  @@index([status])
  @@map("sales")
}

model Expense {
  id          String        @id @default(cuid())
  title       String
  description String?
  amount      Float
  image       String
  status      ExpenseStatus @default(scheduled)
  spentAt     DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  // Personne ayant créé la dépense (utilisateur connecté au moment de la saisie)
  createdById String
  createdBy   User          @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  // Annulation (admin uniquement) : la dépense reste visible avec le statut "cancelled"
  cancelledAt   DateTime?
  // Motif obligatoire saisi par l'admin lors de l'annulation
  cancelReason  String?
  cancelledById String?
  cancelledBy   User?       @relation("ExpenseCancelledBy", fields: [cancelledById], references: [id])

  @@index([createdById])
  @@index([cancelledById])
  @@index([status])
  @@index([spentAt])
  @@map("expenses")
}

enum Role {
  admin
  manager
  saleperson
  assistant
  accountant
}

enum SaleState {
  pending
  validated
  cancelled
}

enum ExpenseStatus {
  scheduled
  in_progress
  done
  cancelled
}
